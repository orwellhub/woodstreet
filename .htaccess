# Wood Street Indoor Market, Apache config (Hostinger)
DirectoryIndex index.html

# The site is a single page. Send the old multi-page URLs, and anything else
# that is not a real file, back to the landing page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.+)\.dc\.html$ / [R=301,L]
</IfModule>

ErrorDocument 404 /index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Photos are cached hard, because a changed photo gets a new filename.
# The page itself must never be cached: the whole site lives in index.html,
# so a cached copy hides every deploy until it expires.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
