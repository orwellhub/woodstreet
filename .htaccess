# Wood Street Indoor Market, Apache/LiteSpeed config (Hostinger)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS, always the bare domain. www redirects to the bare domain,
  # which is the name the TLS certificate is issued for.
  # Note this cannot rescue https://www on its own: the certificate is checked
  # during the TLS handshake, before the server ever sees the request, so the
  # certificate itself must also cover www.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # The first version of the site used Name.dc.html pages. Send those
  # addresses to their replacements.
  RewriteRule ^Home\.dc\.html$ / [R=301,L]
  RewriteRule ^(Traders|Trader)\.dc\.html$ /shops.html [R=301,L]
  RewriteRule ^(Map|MiniMap)\.dc\.html$ /map.html [R=301,L]
  RewriteRule ^(WhatsOn|Event)\.dc\.html$ /whats-on.html [R=301,L]
  RewriteRule ^Visit\.dc\.html$ /visit.html [R=301,L]
  RewriteRule ^Story\.dc\.html$ /story.html [R=301,L]
  RewriteRule ^(Journal|Article)\.dc\.html$ /journal.html [R=301,L]
  RewriteRule ^(Join|Unit|Apply)\.dc\.html$ /join.html [R=301,L]
  RewriteRule ^Contact\.dc\.html$ /contact.html [R=301,L]
  RewriteRule ^Legal\.dc\.html$ /legal.html [R=301,L]
  RewriteRule ^(.+)\.dc\.html$ / [R=301,L]
</IfModule>

# Only the site itself is served. The generator, its data, the archive, the
# audit, the README and any dotfile answer 404 as if they were not there.
# /.well-known/ is the one dotted path that stays public: it carries
# security.txt and the ACME challenges that renew the TLS certificate.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/\.(?!well-known/)
  RedirectMatch 404 ^/(tools/|data/|archive/|security-audit/|README\.md$|CLAUDE\.md$|package\.json$)
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "security\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2

# Photos and fonts are cached hard, because a changed file gets a new name.
# Pages must never be cached, or a cached copy hides every deploy until it
# expires. The stylesheet and script carry a content hash in their URL, so
# they can be cached hard too.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Transport and framing. HSTS is set without includeSubDomains until the
  # certificate covers www; add it (and preload) once it does.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Content Security Policy. Scripts only from this site (there are no inline
  # scripts; the JSON-LD blocks are data, not code). Styles from this site
  # plus inline style attributes, which the pages use throughout. Fonts are
  # self-hosted. The contact form posts to FormSubmit and nowhere else. Nothing
  # may frame the site.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|jpg|webp|png|svg)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>
